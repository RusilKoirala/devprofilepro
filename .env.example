# Early access: the app stays hidden (404) unless this is true. Leave unset in production.
APP_ENABLED=

# Clerk (leave empty in dev to use Clerk's keyless mode)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Clerk → Webhooks → endpoint /api/webhooks/clerk, event user.deleted. Deletes that user's data.
CLERK_WEBHOOK_SIGNING_SECRET=

# Supabase (Clerk added as a Third-Party Auth provider)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# AI: Claude is used when ANTHROPIC_API_KEY is set, otherwise OpenAI
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini            # optional
AI_USER_DAILY_BUDGET_USD=0.50        # optional, per user per day
AI_SERVER_DAILY_BUDGET_USD=2         # optional, per day across all servers (per process without Upstash)

# Rate limits and the shared server-wide AI budget (optional in dev: no limits, and a per-process budget, when unset)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Waitlist
LOOPS_API_KEY=

# Optional
GITHUB_TOKEN=          # fallback for users who signed in without GitHub

# Billing: Dodo Payments (docs/PRICING.md section 7). Leave empty and "Upgrade" joins the Pro list in Loops instead.
DODO_PAYMENTS_API_KEY=               # Dodo → Developer → API keys (test key while DODO_PAYMENTS_ENVIRONMENT=test_mode)
DODO_PAYMENTS_ENVIRONMENT=test_mode  # live_mode in production
DODO_PAYMENTS_WEBHOOK_KEY=           # Dodo → Developer → Webhooks → endpoint secret (whsec_...)
DODO_PRO_MONTHLY_PRODUCT_ID=         # pdt_... ($12/month subscription)
DODO_PRO_PASS_PRODUCT_ID=            # pdt_... ($29 one-time, 90 days)
SUPABASE_SECRET_KEY=                 # Supabase → Project settings → API keys → Secret key. Server only, and required to build a resume: the webhooks, build passes and data deletion use it
NEXT_PUBLIC_APP_URL=                 # e.g. https://devprofile.app, for checkout return links (optional locally)
