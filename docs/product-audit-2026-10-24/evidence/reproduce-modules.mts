import {writeFile} from 'node:fs/promises';
import {analyzeResume} from '../../../lib/ats/analyze.ts';
import {matchKeywords} from '../../../lib/ats/keywords.ts';
import {toLatex} from '../../../lib/resume/latex.ts';
import {buildResume} from '../../../lib/resume/build.ts';
import {editLine} from '../../../lib/record/edits.ts';
const results=[];
const text='Alex Example alex@example.com github.com/alex Experience Built APIs with Go. Education Example University Skills Go';
results.push({case:'short-but-selectable-text',inputCharacters:text.length,result:analyzeResume({text,pages:1,lines:[{page:1,xs:[.08],runs:[text]}],links:[]})});
results.push({case:'Go-only-job',result:matchKeywords('We are hiring a Go developer to build backend services and APIs. Production experience with Go is required for this developer role.','Built backend services with Go.')});
const itemId='11111111-1111-4111-8111-111111111111', bulletId='22222222-2222-4222-8222-222222222222';
const layout={headline:'Developer',section_order:['project'],items:[{item_id:itemId,bullet_ids:[bulletId]}]};
const record:any={items:[{id:itemId,type:'project',data:{name:'Example'},rank:70,status:'shown',pinned:false}],bullets:[{id:bulletId,item_id:itemId,text:'Built a service with Go',fact_ids:[],user_edited:false}]};
const resumes:any={base:{id:'base',kind:'base',layout},tailored:{id:'tailored',kind:'tailored',layout}};
const fake:any={from(table:string){let filters:any={};let op='select';let value:any;const query:any={select(){return query},eq(k:string,v:any){filters[k]=v;return query},update(v:any){op='update';value=v;return query},insert(v:any){op='insert';value=v;return query},single:async()=>result(),maybeSingle:async()=>result(),then:(resolve:any)=>Promise.resolve(result()).then(resolve)};function result(){if(table==='resumes')return {data:resumes[filters.id],error:null};if(table==='facts')return {data:{id:'fact-audit'},error:null};if(table==='bullets'){const b=record.bullets.find((x:any)=>x.id===filters.id);if(op==='update')Object.assign(b,value);return {data:b,error:null}}return {data:null,error:null}}return query}};
const baseBefore=buildResume(layout,record).sections[0].entries[0].bullets[0].text;
await editLine(fake,'tailored',bulletId,'Built an API with Go for the audit');
const baseAfter=buildResume(layout,record).sections[0].entries[0].bullets[0].text;
results.push({case:'edit-tailored-changes-base',method:'actual editLine/buildResume, in-memory database adapter; no live data changed',baseBefore,baseAfter,reproduced:baseBefore!==baseAfter});
const doc:any={name:'Alex',headline:'Developer',contact:{email:'alex@example.com',phone:'',location:'Kathmandu, Nepal',website:'https://example.com',github:'',linkedin:''},sections:[]};
results.push({case:'latex-omits-contact-location',location:doc.contact.location,latexContainsLocation:toLatex(doc).includes(doc.contact.location)});
await writeFile('docs/product-audit-2026-10-24/evidence/module-reproductions.json',JSON.stringify(results,null,2));
console.log(results);
